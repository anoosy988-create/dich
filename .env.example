# ======================================================
#  الداشبورد المستقل — انسخ هذا الملف إلى .env واملأه
# ======================================================

# ---- إجباري ----

# توكن البوت.
# ⚠️  ديسكورد يسمح باتصال واحد فقط لكل توكن.
#    - بداشبورد على نفس السيرفر حق البوت: نفس التوكن عادي ✅
#    - بداشبورد على استضافة ثانية+Bوت شغّال: لازم توكن ثانٍ ⚠️
DISCORD_TOKEN=

# ايدي المالك/الستريتر — اللي يقدر يدير الداشبورد.
# لو أكثر من شخص: افصلهم بفاصلة بدون مسافات
OWNER_IDS=

# نفس قاعدة بيانات البوت (نفس الـ DB)
MONGO_URI=
MONGO_DB=cypher

# من Discord Developer Portal → OAuth2 → General
CLIENT_ID=
CLIENT_SECRET=

# لازم يطابق Redirect URI المسجّل في البورتال بالضبط.
# مثال محلي: http://localhost:10000/api/auth/callback
# مثال Render: https://اسم-التطبيق.onrender.com/api/auth/callback
#
# ملاحظة: لو تركته فاضي، الداشبورد يكتشف الرابط تلقائياً من الطلب
# (يدعم X-Forwarded-Host) — فغالباً ما تحتاج تعبّيه على Render.
# ⚠️ لكن لازم تضيف نفس الرابط في:
#    Discord Developer Portal → OAuth2 → Redirects
DASHBOARD_REDIRECT_URI=

# ---- اختياري ----

# رتبة الستريتر (اللي تطلع بأمر من الداشبورد بلا صلاحية Administrator)
STAFF_ROLE_NAME=ستريتر

# مفتاح توقيع كوكي الجلسة — ولّد قيمة عشوائية طويلة.
# يفضّل نفس SESSION_SECRET حق البوت لو نفس المتصفح يفتح الاثنين.
SESSION_SECRET=

# رابط الداشبورد العام (للروابط داخل الواجهة)
DASHBOARD_URL=

# منفذ التشغيل
PORT=10000
